{
  "openapi": "3.1.0",
  "info": {
    "title": "starter-auth-users",
    "description": "Cookie-session + API-token authentication routes shipped by starter-auth-users.",
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/ui/theme": {
      "get": {
        "tags": [
          "ui-theme"
        ],
        "operationId": "ui_theme_get",
        "responses": {
          "200": {
            "description": "Current theme document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThemeDocument"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          }
        }
      },
      "put": {
        "tags": [
          "ui-theme"
        ],
        "operationId": "ui_theme_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ThemeSaveInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Saved; returns the updated document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThemeDocument"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin role required"
          },
          "413": {
            "description": "Body too large"
          }
        }
      }
    },
    "/api/v1/ui/theme/favicon": {
      "get": {
        "tags": [
          "ui-theme"
        ],
        "operationId": "ui_theme_favicon_get",
        "responses": {
          "200": {
            "description": "Favicon bytes (content-type as stored)"
          },
          "404": {
            "description": "No favicon configured"
          }
        }
      },
      "post": {
        "tags": [
          "ui-theme"
        ],
        "operationId": "ui_theme_favicon_post",
        "requestBody": {
          "description": "Raw image bytes",
          "content": {
            "image/png": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Favicon stored"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin role required"
          },
          "413": {
            "description": "Asset too large"
          },
          "415": {
            "description": "Unsupported media type"
          }
        }
      },
      "delete": {
        "tags": [
          "ui-theme"
        ],
        "operationId": "ui_theme_favicon_delete",
        "responses": {
          "204": {
            "description": "Favicon cleared (idempotent)"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin role required"
          }
        }
      }
    },
    "/api/v1/ui/theme/logo": {
      "get": {
        "tags": [
          "ui-theme"
        ],
        "operationId": "ui_theme_logo_get",
        "responses": {
          "200": {
            "description": "Logo bytes (content-type as stored)"
          },
          "404": {
            "description": "No logo configured"
          }
        }
      },
      "post": {
        "tags": [
          "ui-theme"
        ],
        "operationId": "ui_theme_logo_post",
        "requestBody": {
          "description": "Raw image bytes",
          "content": {
            "image/png": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Logo stored"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin role required"
          },
          "413": {
            "description": "Asset too large"
          },
          "415": {
            "description": "Unsupported media type"
          }
        }
      },
      "delete": {
        "tags": [
          "ui-theme"
        ],
        "operationId": "ui_theme_logo_delete",
        "responses": {
          "204": {
            "description": "Logo cleared (idempotent)"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin role required"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Logged in; session + CSRF cookies set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Account has no local password; sign in via a linked provider",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordNotSetResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Logged out (idempotent)"
          },
          "403": {
            "description": "CSRF token missing or mismatched"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "me",
        "responses": {
          "200": {
            "description": "Current user identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "description": "Request body for `POST /auth/login`.",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "User's email (the primary identifier in `starter_auth_users`)."
          },
          "password": {
            "type": "string",
            "description": "Plaintext password."
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "description": "Response body for `POST /auth/login`.",
        "required": [
          "csrf_token"
        ],
        "properties": {
          "csrf_token": {
            "type": "string",
            "description": "CSRF double-submit token. Send back as `X-CSRF-Token` on\nmutating cookie-authenticated requests."
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "description": "Response body for `GET /auth/me`.",
        "required": [
          "subject",
          "email",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "User's email."
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "Role: reader / writer / admin."
          },
          "subject": {
            "type": "string",
            "description": "Stable user identifier (the `Principal.subject`)."
          }
        }
      },
      "PasswordNotSetResponse": {
        "type": "object",
        "description": "Body returned by `POST /auth/login` when the matched user has no\nlocal password (`password_hash IS NULL`). The SPA reads\n`providers` to render \"Sign in with GitHub / Google\" buttons\nwithout a guess-and-check round trip.",
        "required": [
          "error",
          "providers"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Always `\"password_not_set\"`. Discriminator field; lets clients\npattern-match without inspecting the HTTP status alone."
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Provider ids the user has linked. Empty list when no\nthird-party path is configured (the default\n[`crate::NoLinkedProviders`] impl)."
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "Machine-readable error body.\n\nMirrors RFC 7807 loosely. The `type` field is a stable string\nidentifier (`not_found`, `invalid_input`, …) that callers can\nswitch on; the HTTP status is set by the transport.",
        "required": [
          "type",
          "title"
        ],
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional detailed explanation."
          },
          "title": {
            "type": "string",
            "description": "Short human title for the problem."
          },
          "type": {
            "type": "string",
            "description": "Stable identifier for the error class. Matches lower-case\nsnake-case of [`crate::error::Error`] variants."
          }
        }
      },
      "Role": {
        "type": "string",
        "description": "Coarse permission level. Three roles are enough for the common\ncase; consumers needing more wire their own `Authenticator` and\ntranslate to/from this set at the boundary.",
        "enum": [
          "reader",
          "writer",
          "admin"
        ]
      },
      "ShellConfig": {
        "type": "object",
        "description": "Non-token branding choices that travel with the theme.\n\n`hide_features` carries consumer-defined string ids — starter\nitself attaches no meaning to them; the consumer's shell layer\nreads the list and hides the matching nav items.",
        "properties": {
          "hide_features": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Consumer-defined feature ids the admin wants hidden."
          },
          "nav_title": {
            "type": "string",
            "description": "Display name shown in the top nav."
          }
        }
      },
      "ThemeDocument": {
        "type": "object",
        "description": "The full org-level theme: style maps, branding sidecar, and the\n(optional) URLs of the uploaded logo / favicon.\n\nAsset URLs are `None` until the consumer uploads each asset; the\nfrontend treats `None` as \"fall back to your bundled defaults\".",
        "required": [
          "theme_styles",
          "shell"
        ],
        "properties": {
          "favicon_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where the server serves the favicon, if any."
          },
          "logo_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where the server serves the logo, if any."
          },
          "shell": {
            "$ref": "#/components/schemas/ShellConfig",
            "description": "Branding sidecar."
          },
          "theme_styles": {
            "$ref": "#/components/schemas/ThemeStyles",
            "description": "Light + dark token maps."
          }
        }
      },
      "ThemeSaveInput": {
        "type": "object",
        "description": "Editor → server save payload. Mirrors the shape the frontend\n`httpThemeTransport.save({ theme_styles, shell })` already sends.\n\nAsset URLs are *not* in this DTO — uploads are separate\n`POST /api/v1/ui/theme/{logo,favicon}` endpoints so the JSON\nsurface stays plain JSON (no multipart juggling).",
        "required": [
          "theme_styles",
          "shell"
        ],
        "properties": {
          "shell": {
            "$ref": "#/components/schemas/ShellConfig",
            "description": "Branding sidecar."
          },
          "theme_styles": {
            "$ref": "#/components/schemas/ThemeStyles",
            "description": "Light + dark token maps."
          }
        }
      },
      "ThemeStyles": {
        "type": "object",
        "description": "Light + dark CSS-custom-property maps.\n\nKeys are the unprefixed token names (`\"primary\"`, not\n`\"--primary\"`); the frontend stamps the `--` prefix at apply\ntime. Values are CSS strings — colours, lengths, font stacks —\nwhatever the corresponding token expects. See the token surface\ntable in `DOCS/frontend/theme/README.md` for the canonical\n38-key set.\n\n`BTreeMap` rather than `HashMap`: serialised output is\ndeterministic, which keeps OpenAPI snapshots and integration\ntests stable.",
        "properties": {
          "dark": {
            "type": "object",
            "description": "Tokens applied when the resolved mode is `dark`.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "light": {
            "type": "object",
            "description": "Tokens applied when the resolved mode is `light`.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "auth",
      "description": "Authentication endpoints"
    },
    {
      "name": "ui-theme",
      "description": "Org-level theme persistence"
    }
  ]
}
