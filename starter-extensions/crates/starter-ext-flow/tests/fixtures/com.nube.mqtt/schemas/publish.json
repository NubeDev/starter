{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "com.nube.mqtt.publish settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["broker", "topic"],
  "properties": {
    "broker": {
      "type": "string",
      "description": "MQTT broker URL (e.g. mqtt://localhost:1883)."
    },
    "topic": {
      "type": "string",
      "description": "Topic to publish to."
    },
    "qos": {
      "type": "integer",
      "enum": [0, 1, 2],
      "default": 0
    },
    "retain": {
      "type": "boolean",
      "default": false
    }
  }
}
