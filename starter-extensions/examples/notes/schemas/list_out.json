{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoteList",
  "type": "object",
  "properties": {
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id":   { "type": "integer" },
          "body": { "type": "string" }
        },
        "required": ["id", "body"]
      }
    }
  },
  "required": ["notes"]
}
