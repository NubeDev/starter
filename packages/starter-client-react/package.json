{
  "name": "@nube/starter-client-react",
  "version": "0.1.0",
  "description": "React bindings for @nube/starter-client-ts — TanStack Query provider, StarterClientProvider, and shared hooks (auth, SSE). Zero endpoint code; that lives in sibling typed packages.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "@tanstack/react-query": "^5"
  },
  "dependencies": {
    "@nube/starter-client-ts": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.4",
    "vitest": "^2.1.0"
  }
}
