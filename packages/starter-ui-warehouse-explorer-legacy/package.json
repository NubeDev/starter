{
  "name": "@nube/starter-ui-warehouse-explorer-legacy",
  "version": "0.1.0",
  "description": "Headless React component library for the ClickHouse explorer (forked from sql-studio, MIT). Mounts inside a host that provides QueryClient, theme tokens, and (for mutations) the rubix client. Backend: GET /api/warehouse/ch/* and the rubix.warehouse.* verb family.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./views": "./src/views/index.ts",
    "./rubix": "./src/rubix/index.ts",
    "./i18n": "./src/i18n/index.ts"
  },
  "files": [
    "README.md",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@nube/rubix-client-react": "workspace:*",
    "@nube/starter-client-react": "workspace:*",
    "@nube/starter-client-ts": "workspace:*",
    "@nube/starter-ui-kit": "workspace:*",
    "@tanstack/react-query": "^5",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@nube/rubix-client-react": {
      "optional": true
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-table": "^8.21.3",
    "@uidotdev/usehooks": "^2.4.1",
    "@xyflow/react": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "lucide-react": "^0.533.0",
    "monaco-editor": "^0.52.2",
    "monaco-sql-languages": "^0.15.1",
    "react-code-blocks": "^0.1.6",
    "react-data-grid": "^7.0.0-beta.56",
    "recharts": "^3.1.0",
    "sql-formatter": "^15.6.10",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.11"
  },
  "devDependencies": {
    "@nube/rubix-client-react": "workspace:*",
    "@nube/starter-client-react": "workspace:*",
    "@nube/starter-client-ts": "workspace:*",
    "@nube/starter-ui-kit": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toggle": "^1.1.9",
    "@tanstack/react-query": "^5.83.0",
    "@types/dagre": "^0.7.53",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.4"
  }
