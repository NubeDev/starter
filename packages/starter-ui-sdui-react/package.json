{
  "name": "@nube/starter-ui-sdui-react",
  "version": "0.1.0",
  "description": "Headless SDUI page renderer. Mounts a `<SduiPage page_ref target_ref />`, resolves the IR via an injected `SduiTransport`, and dispatches one renderer per IR variant. Zero I/O — the rubix frontend (or any starter consumer) supplies the transport adapter.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nube/starter-ui-ir": "workspace:*",
    "@tanstack/react-query": "^5.59.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@nube/starter-client-ts": "workspace:*",
    "@nube/starter-ui-kit": "workspace:*"
  },
  "devDependencies": {
    "@nube/starter-ui-ir": "workspace:*",
    "@tanstack/react-query": "^5.59.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.4",
    "vitest": "^2.1.0"
  }
}
