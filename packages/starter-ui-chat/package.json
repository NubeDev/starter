{
  "name": "@nube/starter-ui-chat",
  "version": "0.2.0",
  "description": "Reusable React AI-chat components and hooks. Headless transport via a ChatAdapter; styled with @nube/starter-ui-kit. Zero I/O.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks": "./src/hooks/index.ts",
    "./types": "./src/types/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./styles.css": "./styles.css"
  },
  "files": [
    "README.md",
    "src",
    "styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@nube/starter-ui-kit": "workspace:*",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@nube/starter-ui-kit": "workspace:*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.4"
  }
}
