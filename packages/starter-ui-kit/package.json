{
  "name": "@nube/starter-ui-kit",
  "version": "0.1.0",
  "description": "shadcn/ui primitives + Tailwind v4 tokens + theme switch. Zero I/O. (SCOPE.md R6)",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/globals.css",
    "./scan-source.css": "./src/styles/scan-source.css",
    "./theme-editor": "./src/theme-editor/index.ts",
    "./theme-editor/config-drawer": "./src/theme-editor/config-drawer/index.ts",
    "./components/*": "./src/components/ui/*.tsx",
    "./lib/utils": "./src/lib/utils.ts"
  },
  "files": ["src", "components.json", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:css": "tsx scripts/generate-css.ts write",
    "verify:css": "tsx scripts/generate-css.ts verify",
    "prebuild": "tsx scripts/generate-css.ts verify"
  },
  "peerDependencies": {
    "@nube/starter-ui-core": "workspace:*",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.469.0",
    "radix-ui": "^1.4.3",
    "react-resizable-panels": "^4.10.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@nube/starter-theme-tokens": "workspace:*",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5.4"
  }
}
