{
  "name": "@nube/starter-ui-core",
  "version": "0.1.0",
  "description": "React glue for starter: AuthProvider/useAuth, query-key namespacing, testing helpers. Wraps @nube/starter-client-ts.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth/index.ts",
    "./query": "./src/query/index.ts",
    "./testing": "./src/testing/index.ts",
    "./theme-editor": "./src/theme-editor/index.ts",
    "./preferences": "./src/preferences/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./layout": "./src/layout/index.ts",
    "./styles.css": "./styles.css"
  },
  "files": [
    "README.md",
    "src",
    "styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "dependencies": {
    "@nube/starter-client-ts": "workspace:*",
    "@nube/starter-theme-tokens": "workspace:*",
    "@radix-ui/react-direction": "^1.1.0",
    "@tanstack/react-query": "^5.59.0",
    "culori": "^4.0.1",
    "react-intl": "^7.1.14",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/culori": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
