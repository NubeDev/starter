{
  "name": "@nube/starter-ui-ai-builder",
  "version": "0.1.0",
  "description": "React surface for the ai-builder page slice: a split-pane that pairs a chat composer (from @nube/starter-ui-chat) with a live SDUI canvas (from @nube/starter-sdui-react). Streams BuilderEvent frames from a transport-agnostic BuilderAdapter; zero I/O. See DOCS/frontend/ai-builder/SCOPE.md.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks": "./src/hooks/index.ts",
    "./types": "./src/types/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./styles.css": "./styles.css"
  },
  "files": [
    "README.md",
    "src",
    "styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nube/starter-sdui-react": "workspace:*",
    "@nube/starter-ui-chat": "workspace:*",
    "@nube/starter-ui-kit": "workspace:*",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@nube/starter-sdui-react": "workspace:*",
    "@nube/starter-ui-chat": "workspace:*",
    "@nube/starter-ui-kit": "workspace:*",
    "@tanstack/react-query": "^5.59.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.4",
    "vitest": "^2.1.0"
  }
}
