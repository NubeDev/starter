{
  "name": "@nube/starter-sdui-react",
  "version": "0.1.0",
  "description": "React renderer for starter SDUI trees. Ports rubix-ui-core/src/sdui/ verbatim and projects against @nube/starter-ui-kit shadcn primitives (divergence D2 \u2014 see DOCS/frontend/sdui/DIVERGENCE.md).",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./styles.css"
  },
  "files": [
    "README.md",
    "src",
    "styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@nube/starter-ui-core": "workspace:*",
    "@nube/starter-ui-kit": "workspace:*",
    "@tanstack/react-query": "^5.59.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.4",
    "vitest": "^2.1.0"
  }
}
