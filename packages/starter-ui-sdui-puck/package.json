{
  "name": "@nube/starter-ui-sdui-puck",
  "version": "0.1.0",
  "description": "Puck-powered visual SDUI editor. Consumes the committed starter-ui-ir JSON Schema and emits one Puck ComponentConfig per author-time variant; pairs with @nube/starter-ui-sdui-react's renderers on the read path. See rubix/docs/scope/dashboards/10-puck-builder.md for the scope this implements.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/check-schema-drift.mjs && node scripts/emit-schema-hash.mjs && vitest run",
    "harness": "vite --config harness/vite.config.ts"
  },
  "peerDependencies": {
    "@measured/puck": "^0.19.0",
    "@nube/starter-ui-ir": "workspace:*",
    "@nube/starter-ui-sdui-react": "workspace:*",
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {},
  "devDependencies": {
    "@measured/puck": "^0.19.0",
    "@nube/starter-ui-ir": "workspace:*",
    "@nube/starter-ui-sdui-react": "workspace:*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.4",
    "vite": "^6.0.7",
    "vitest": "^2.1.0"
  }
}
