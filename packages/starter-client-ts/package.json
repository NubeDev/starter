{
  "name": "@nube/starter-client-ts",
  "version": "0.1.0",
  "description": "TS HTTP client for starter-server. Codegen'd from OpenAPI. Zero React.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated/index.ts"
  },
  "files": ["src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "codegen": "openapi-typescript ../../openapi.json -o ./src/generated/index.ts"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
