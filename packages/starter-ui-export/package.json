{
  "name": "@nube/starter-ui-export",
  "version": "0.1.0",
  "description": "Print-to-PDF UI (portrait/landscape, page size, margins) + browser-side PDF export helpers. Zero I/O. (SCOPE.md R6)",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./PageOptionsForm": "./src/PageOptionsForm.tsx",
    "./ExportButton": "./src/ExportButton.tsx",
    "./printNode": "./src/printNode.ts",
    "./exportNodeToPdf": "./src/exportNodeToPdf.ts"
  },
  "files": ["src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "html2canvas": { "optional": true },
    "jspdf": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.4"
  }
}
