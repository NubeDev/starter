{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rubix Provision",
  "version": "0.1.0",
  "identifier": "com.nubeio.rubixos.provision",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421"
  },
  "app": {
    "windows": [
      {
        "title": "Rubix Provision",
        "width": 420,
        "height": 900,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
