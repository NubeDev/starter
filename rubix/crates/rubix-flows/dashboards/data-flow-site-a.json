{
  "ir_version": 5,
  "title": "Data flow — Site A",
  "root": {
    "type": "page",
    "id": "page",
    "title": "Site A — energy + water",
    "default_row_gap": "1rem",
    "default_column_gap": "1rem",
    "default_page_padding": "1.5rem",
    "default_max_width": "80rem",
    "children": [
      {
        "type": "row",
        "id": "kpis",
        "children": [
          {
            "type": "col",
            "span": 6,
            "children": [
              {
                "type": "kpi",
                "id": "kpi-kwh-24h",
                "label": "Site A — last 24h kWh",
                "format": "number",
                "unit_symbol": "kWh",
                "source": {
                  "type": "analytics_template",
                  "name": "meter_kwh_last_24h",
                  "params": { "tenant_id": "site-a" },
                  "map": { "value_field": "kwh" }
                }
              }
            ]
          },
          {
            "type": "col",
            "span": 6,
            "children": [
              {
                "type": "kpi",
                "id": "kpi-litres-24h",
                "label": "Site A — last 24h L",
                "format": "number",
                "unit_symbol": "L",
                "source": {
                  "type": "analytics_template",
                  "name": "meter_litres_last_24h",
                  "params": { "tenant_id": "site-a" },
                  "map": { "value_field": "litres" }
                }
              }
            ]
          }
        ]
      },
      {
        "type": "row",
        "id": "charts",
        "children": [
          {
            "type": "col",
            "span": 4,
            "children": [
              {
                "type": "chart",
                "id": "chart-elec-main",
                "kind": "line",
                "page_state_key": "elec_main_range",
                "sources": [
                  {
                    "type": "analytics_template",
                    "name": "meter_value_30d_15m",
                    "params": {
                      "tenant_id": "site-a",
                      "meter_id": "site-a.elec.main"
                    },
                    "map": {
                      "ts_field": "bucket_start",
                      "value_field": "value_avg"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "col",
            "span": 4,
            "children": [
              {
                "type": "chart",
                "id": "chart-elec-hvac",
                "kind": "line",
                "page_state_key": "elec_hvac_range",
                "sources": [
                  {
                    "type": "analytics_template",
                    "name": "meter_value_30d_15m",
                    "params": {
                      "tenant_id": "site-a",
                      "meter_id": "site-a.elec.hvac"
                    },
                    "map": {
                      "ts_field": "bucket_start",
                      "value_field": "value_avg"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "col",
            "span": 4,
            "children": [
              {
                "type": "chart",
                "id": "chart-water-main",
                "kind": "line",
                "page_state_key": "water_main_range",
                "sources": [
                  {
                    "type": "analytics_template",
                    "name": "meter_value_30d_15m",
                    "params": {
                      "tenant_id": "site-a",
                      "meter_id": "site-a.water.main"
                    },
                    "map": {
                      "ts_field": "bucket_start",
                      "value_field": "value_avg"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "row",
        "id": "charts-l2-zoom",
        "children": [
          {
            "type": "col",
            "span": 4,
            "children": [
              {
                "type": "chart",
                "id": "chart-elec-main-l2",
                "kind": "line",
                "page_state_key": "elec_main_zoom",
                "sources": [
                  {
                    "type": "analytics_template",
                    "name": "meter_value_24h_1m",
                    "params": {
                      "tenant_id": "site-a",
                      "meter_id": "site-a.elec.main"
                    },
                    "map": {
                      "ts_field": "bucket_start",
                      "value_field": "value_avg"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "col",
            "span": 4,
            "children": [
              {
                "type": "chart",
                "id": "chart-elec-hvac-l2",
                "kind": "line",
                "page_state_key": "elec_hvac_zoom",
                "sources": [
                  {
                    "type": "analytics_template",
                    "name": "meter_value_24h_1m",
                    "params": {
                      "tenant_id": "site-a",
                      "meter_id": "site-a.elec.hvac"
                    },
                    "map": {
                      "ts_field": "bucket_start",
                      "value_field": "value_avg"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "col",
            "span": 4,
            "children": [
              {
                "type": "chart",
                "id": "chart-water-main-l2",
                "kind": "line",
                "page_state_key": "water_main_zoom",
                "sources": [
                  {
                    "type": "analytics_template",
                    "name": "meter_value_24h_1m",
                    "params": {
                      "tenant_id": "site-a",
                      "meter_id": "site-a.water.main"
                    },
                    "map": {
                      "ts_field": "bucket_start",
                      "value_field": "value_avg"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
