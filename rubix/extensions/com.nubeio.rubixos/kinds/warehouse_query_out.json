{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WarehouseQueryOutput",
  "description": "Result of a named warehouse-template query. The shape of each row is template-specific.",
  "type": "object",
  "properties": {
    "template": { "type": "string" },
    "rows": {
      "type": "array",
      "items": { "type": "object" }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "description": "Convenience tally — `rows.length`."
    }
  },
  "required": ["template", "rows", "count"],
  "additionalProperties": false
}
