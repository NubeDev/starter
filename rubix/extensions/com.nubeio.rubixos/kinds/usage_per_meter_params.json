{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UsagePerMeterParams",
  "description": "Per-point aggregates over a set of meter point_uuids and a time window. `point_uuids` is a comma-separated string.",
  "type": "object",
  "properties": {
    "point_uuids": { "type": "string", "minLength": 1 },
    "from":        { "type": "string", "format": "date-time" },
    "to":          { "type": "string", "format": "date-time" },
    "limit":       { "type": "integer", "minimum": 1, "maximum": 1000, "default": 200 }
  },
  "required": ["point_uuids", "from", "to"],
  "additionalProperties": false
}
