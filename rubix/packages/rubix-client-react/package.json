{
  "name": "@nube/rubix-client-react",
  "version": "0.1.0",
  "description": "React bindings for @nube/rubix-client-ts — typed hooks per rubix-agent endpoint family, plus a RubixClientProvider that mounts a sibling StarterClientProvider under the hood. Endpoint hooks live here; transport lives in @nube/starter-client-react.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "@tanstack/react-query": "^5"
  },
  "dependencies": {
    "@nube/rubix-client-ts": "workspace:*",
    "@nube/starter-client-react": "workspace:*"
  },
  "devDependencies": {
    "@nube/starter-client-ts": "workspace:*",
    "@tanstack/react-query": "^5.59.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^25.0.0",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.4",
    "vitest": "^2.1.0"
  }
}
