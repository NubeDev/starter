{
  "name": "@nube/ce-wiresheet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Control-engine wiresheet editor (REST + binary-WS, React Flow). Source-only workspace package shared by the standalone dev harness and the com.nubeio.ce extension.",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "bench": "vitest bench --run",
    "bench:baseline": "vitest bench --run --outputJson bench-baseline.json",
    "bench:compare": "vitest bench --run --compare bench-baseline.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.1",
    "@typescript/vfs": "^1.6.4",
    "@uiw/react-codemirror": "^4.25.10",
    "@xyflow/react": "^12.3.0",
    "lucide-react": "^0.469.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^25.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
