          }
        ]
      },
      {
        "description": "Footer with refresh information",
        "type": "stack",
        "id": "root.footer",
        "gap": "xs",
        "style": {
          "className": "rounded-lg border border-border/40 bg-muted/20 p-4 mt-4 text-xs text-muted-foreground"
        },
        "children": [
          {
            "type": "text",
            "value": "Last dashboard refresh: Just now · Data updates every 30 seconds"
          }
        ]
      }
    ]
