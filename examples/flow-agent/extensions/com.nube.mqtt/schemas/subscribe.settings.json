{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MqttSubscribeSettings",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic"],
  "properties": {
    "topic": {
      "type": "string",
      "description": "MQTT topic filter to subscribe to (supports + and # wildcards).",
      "minLength": 1
    },
    "qos": {
      "type": "integer",
      "enum": [0, 1, 2],
      "default": 0,
      "description": "MQTT QoS level the subscription is opened at."
    }
  }
}
