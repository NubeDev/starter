{
  "name": "flow-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Frontend for the flow-agent example. Flow editor + AI agent chat on starter-* libraries.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@nube/starter-client-ts": "workspace:*",
    "@nube/starter-sdui-react": "workspace:*",
    "@nube/starter-ui-ai-builder": "workspace:*",
    "@nube/starter-ui-chat": "workspace:*",
    "@nube/starter-ui-core": "workspace:*",
    "@nube/starter-ui-flow": "workspace:*",
    "@nube/starter-ui-kit": "workspace:*",
    "@nube/starter-ui-skills": "workspace:*",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.59.0",
    "@xyflow/react": "^12.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.26.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uplot": "^1.6.32",
    "uplot-react": "^1.2.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
