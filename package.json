{
  "name": "starter-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Root of the starter pnpm workspace. Not published. See packages/* for the published artifacts.",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "codegen": "pnpm --filter @nube/starter-client-ts run codegen",
    "check:i18n": "node scripts/check-i18n.mjs",
    "api:check": "node scripts/check-public-api.mjs",
    "api:update": "node scripts/check-public-api.mjs --update",
    "check:no-alias-imports": "node scripts/check-no-alias-imports.mjs"
  }
}
