{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nexus client theme",
  "description": "Centralised, client-editable theme. Edit this file (or replace theme.json with a client's copy) to rebrand the app — no code changes. Every token is a CSS colour (any space: hsl/oklch/rgb/hex) except `radius` (a CSS length). Omitted tokens fall back to the starter kit's own defaults.",
  "type": "object",
  "required": ["name", "defaultMode", "tokens"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string", "description": "Brand/theme name; lower-cased onto <html data-theme>." },
    "description": { "type": "string" },
    "defaultMode": {
      "enum": ["light", "dark", "system"],
      "description": "Mode used on first visit, before the user picks one."
    },
    "tokens": {
      "type": "object",
      "required": ["light", "dark"],
      "properties": {
        "light": { "$ref": "#/$defs/tokenMap" },
        "dark": { "$ref": "#/$defs/tokenMap" }
      }
    }
  },
  "$defs": {
    "tokenMap": {
      "type": "object",
      "additionalProperties": false,
      "description": "Partial token map for one mode. All values are CSS colours except `radius`.",
      "properties": {
        "background": { "type": "string" },
        "foreground": { "type": "string" },
        "card": { "type": "string" },
        "card-foreground": { "type": "string" },
        "popover": { "type": "string" },
        "popover-foreground": { "type": "string" },
        "primary": { "type": "string" },
        "primary-foreground": { "type": "string" },
        "secondary": { "type": "string" },
        "secondary-foreground": { "type": "string" },
        "muted": { "type": "string" },
        "muted-foreground": { "type": "string" },
        "accent": { "type": "string" },
        "accent-foreground": { "type": "string" },
        "destructive": { "type": "string" },
        "destructive-foreground": { "type": "string" },
        "border": { "type": "string" },
        "input": { "type": "string" },
        "ring": { "type": "string" },
        "chart-1": { "type": "string" },
        "chart-2": { "type": "string" },
        "chart-3": { "type": "string" },
        "chart-4": { "type": "string" },
        "chart-5": { "type": "string" },
        "sidebar": { "type": "string" },
        "sidebar-foreground": { "type": "string" },
        "sidebar-primary": { "type": "string" },
        "sidebar-primary-foreground": { "type": "string" },
        "sidebar-accent": { "type": "string" },
        "sidebar-accent-foreground": { "type": "string" },
        "sidebar-border": { "type": "string" },
        "sidebar-ring": { "type": "string" },
        "radius": { "type": "string", "description": "CSS length, e.g. 0.5rem." }
      }
    }
  }
}
