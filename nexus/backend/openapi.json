{
  "openapi": "3.1.0",
  "info": {
    "title": "Nexus API",
    "description": "Control plane for the Nexus observability/BI platform: datasources, one-shot queries, live SSE streams, dashboards, and panels.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/dashboards": {
      "get": {
        "tags": [
          "dashboards"
        ],
        "operationId": "list_dashboards",
        "responses": {
          "200": {
            "description": "Dashboards",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DashboardSummary"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "dashboards"
        ],
        "operationId": "create_dashboard",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDashboardRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardSummary"
                }
              }
            }
          },
          "409": {
            "description": "Slug already used in this tenant"
          }
        }
      }
    },
    "/api/v1/dashboards/{slug}": {
      "get": {
        "tags": [
          "dashboards"
        ],
        "operationId": "get_dashboard",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "description": "Dashboard slug (route alias)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard with panels",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not found in this tenant"
          }
        }
      },
      "delete": {
        "tags": [
          "dashboards"
        ],
        "operationId": "delete_dashboard",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "description": "Dashboard slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "Not found in this tenant"
          }
        }
      }
    },
    "/api/v1/dashboards/{slug}/panels": {
      "post": {
        "tags": [
          "panels"
        ],
        "operationId": "add_panel",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "description": "Dashboard slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePanelRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Panel added",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PanelDetail"
                }
              }
            }
          },
          "404": {
            "description": "Dashboard not found in this tenant"
          }
        }
      }
    },
    "/api/v1/datasources": {
      "get": {
        "tags": [
          "datasources"
        ],
        "operationId": "list_datasources",
        "responses": {
          "200": {
            "description": "Datasources",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DatasourceSummary"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "datasources"
        ],
        "summary": "Seal the secret and insert the datasource under the caller's tenant.",
        "operationId": "create_datasource",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDatasourceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasourceDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/datasources/{id}": {
      "get": {
        "tags": [
          "datasources"
        ],
        "operationId": "get_datasource",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Datasource id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Datasource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasourceDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not found in this tenant"
          }
        }
      },
      "delete": {
        "tags": [
          "datasources"
        ],
        "operationId": "delete_datasource",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Datasource id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "Not found in this tenant"
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Map the authenticated `Principal` to the richer context DTO. 401 when no\nprincipal is present (the request was unauthenticated).",
        "operationId": "get_me",
        "responses": {
          "200": {
            "description": "Caller context",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      }
    },
    "/api/v1/panels/{id}": {
      "delete": {
        "tags": [
          "panels"
        ],
        "operationId": "delete_panel",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Panel id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "Not found in this tenant"
          }
        }
      }
    },
    "/api/v1/query": {
      "post": {
        "tags": [
          "query"
        ],
        "summary": "Extract the SQL, run it under the server guards, return the rows. The guards\n(read-only, timeout, caps) live in the store; this handler only wires.",
        "operationId": "run_query",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Query result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or rejected query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/streams": {
      "post": {
        "tags": [
          "streams"
        ],
        "operationId": "create_stream",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateStreamRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Stream created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateStreamResponse"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed to view the datasource"
          },
          "404": {
            "description": "Datasource not found in this tenant"
          }
        }
      }
    },
    "/api/v1/streams/{id}": {
      "get": {
        "tags": [
          "streams"
        ],
        "summary": "SSE subscription. Returns 401 on a missing/expired/forged token, otherwise an\nevent stream.",
        "operationId": "subscribe_stream",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Stream id from POST /streams",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "token",
            "in": "query",
            "description": "Signed subscription token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE event stream",
            "content": {
              "text/event-stream": {}
            }
          },
          "401": {
            "description": "Missing/expired/invalid token"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ColumnSchema": {
        "type": "object",
        "description": "One column of a query result.",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Column name as it appears in the result set."
          },
          "type": {
            "$ref": "#/components/schemas/ResultColumnType",
            "description": "Coarse logical type for rendering."
          }
        }
      },
      "CreateDashboardRequest": {
        "type": "object",
        "description": "Create a dashboard. The slug must be unique within the tenant; the server\nrejects a duplicate rather than silently aliasing.",
        "required": [
          "slug",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "CreateDatasourceRequest": {
        "type": "object",
        "description": "Body for creating a datasource. The `password` is write-only: it is accepted\nhere, envelope-encrypted at rest, and never echoed back by any read\nendpoint.",
        "required": [
          "name",
          "kind",
          "host",
          "port",
          "database",
          "user",
          "password"
        ],
        "properties": {
          "database": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/DatasourceKind",
            "description": "Which connector to use."
          },
          "name": {
            "type": "string",
            "description": "Human-readable name shown in the datasource picker."
          },
          "password": {
            "type": "string",
            "description": "Write-only secret. Stored as ciphertext; absent from every response."
          },
          "port": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "user": {
            "type": "string"
          }
        }
      },
      "CreatePanelRequest": {
        "type": "object",
        "description": "Create a panel under the dashboard named in the path. The dashboard is keyed\nby its immutable id (resolved from the path slug at the request edge).",
        "required": [
          "title",
          "datasource_id",
          "sql"
        ],
        "properties": {
          "datasource_id": {
            "type": "string",
            "format": "uuid",
            "description": "Datasource this panel queries."
          },
          "layout": {
            "description": "Grid layout; defaults to empty when omitted."
          },
          "sql": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "viz": {
            "type": [
              "string",
              "null"
            ],
            "description": "Visualization kind; defaults to `table` when omitted."
          }
        }
      },
      "CreateStreamRequest": {
        "type": "object",
        "description": "Body for creating a live stream: the datasource to read and the SQL shaping\napplied to each batch before it is pushed to subscribers.",
        "required": [
          "datasource_id",
          "sql"
        ],
        "properties": {
          "datasource_id": {
            "type": "string",
            "format": "uuid",
            "description": "Datasource whose live input feeds this stream."
          },
          "sql": {
            "type": "string",
            "description": "SQL applied per batch (DataFusion pipeline) to shape the live rows."
          }
        }
      },
      "CreateStreamResponse": {
        "type": "object",
        "description": "Result of creating a stream. The token is single-use-per-connection,\nshort-lived, and scoped to exactly this stream — it authorizes the SSE\nsubscription and nothing else.",
        "required": [
          "id",
          "token",
          "subscribe_url",
          "expires_in_secs"
        ],
        "properties": {
          "expires_in_secs": {
            "type": "integer",
            "format": "int64",
            "description": "Token lifetime in seconds; the client must connect before it expires.",
            "minimum": 0
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Immutable stream id."
          },
          "subscribe_url": {
            "type": "string",
            "description": "Relative URL to connect an `EventSource` to, with the token embedded."
          },
          "token": {
            "type": "string",
            "description": "Signed token to pass as `?token=` when opening the SSE connection."
          }
        }
      },
      "DashboardDetail": {
        "type": "object",
        "description": "Full dashboard view: identity plus its ordered panels. The slug resolves to\nthe `id` at the request edge; everything below keys on the id.",
        "required": [
          "id",
          "slug",
          "name",
          "panels"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "panels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PanelDetail"
            }
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "DashboardSummary": {
        "type": "object",
        "description": "A dashboard in a list: identity, route alias, and display name.",
        "required": [
          "id",
          "slug",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Immutable id — grants and panel refs key on this."
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "description": "Mutable route alias."
          }
        }
      },
      "DatasourceDetail": {
        "type": "object",
        "description": "Full datasource view. The connection is redacted — host/port/database/user\nonly, never the secret.",
        "required": [
          "id",
          "name",
          "kind",
          "connection"
        ],
        "properties": {
          "connection": {
            "$ref": "#/components/schemas/RedactedConnection"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Immutable datasource id."
          },
          "kind": {
            "$ref": "#/components/schemas/DatasourceKind"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "DatasourceKind": {
        "type": "string",
        "description": "The kind of datasource, which selects the ArkFlow input builder. v1 ships\nSQL-over-Postgres as the first connector; the enum is the extension point as\nmore `register_input_builder` connectors land.",
        "enum": [
          "postgres"
        ]
      },
      "DatasourceSummary": {
        "type": "object",
        "description": "A datasource as it appears in a list — identity and kind only, no connection\ndetail. Use `GET /datasources/:id` for the redacted connection view.",
        "required": [
          "id",
          "name",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Immutable datasource id (grants and panel refs key on this)."
          },
          "kind": {
            "$ref": "#/components/schemas/DatasourceKind"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "description": "The authenticated caller's full context.",
        "required": [
          "subject",
          "role",
          "teams",
          "scopes"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "Coarse role: `reader` | `writer` | `admin`."
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Fine-grained scope strings attached to the credential."
          },
          "subject": {
            "type": "string",
            "description": "Stable subject id (the user id)."
          },
          "teams": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Team slugs the caller belongs to in the current tenant. Grants reference\nteams by slug, so the SPA matches against these."
          },
          "tenant_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Tenant the session is bound to. `None` for an unbound principal; `\"*\"`\nmarks a super-admin that bypasses the cross-tenant predicate."
          }
        }
      },
      "PanelDetail": {
        "type": "object",
        "description": "A panel as the canvas renders it: which datasource + query feed it, how it is\ndrawn, and where it sits on the grid.",
        "required": [
          "id",
          "title",
          "sql",
          "viz",
          "layout"
        ],
        "properties": {
          "datasource_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Datasource the panel queries. `None` if its datasource was deleted."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "layout": {
            "description": "Opaque grid layout the canvas owns."
          },
          "sql": {
            "type": "string",
            "description": "The panel's SQL, run under the server query guards when refreshed."
          },
          "title": {
            "type": "string"
          },
          "viz": {
            "type": "string",
            "description": "Visualization kind: `line` | `bar` | `table` | `stat` | …"
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "Machine-readable error body.\n\nMirrors RFC 7807 loosely. The `type` field is a stable string\nidentifier (`not_found`, `invalid_input`, …) that callers can\nswitch on; the HTTP status is set by the transport.",
        "required": [
          "type",
          "title"
        ],
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional detailed explanation."
          },
          "title": {
            "type": "string",
            "description": "Short human title for the problem."
          },
          "type": {
            "type": "string",
            "description": "Stable identifier for the error class. Matches lower-case\nsnake-case of [`crate::error::Error`] variants."
          }
        }
      },
      "QueryRequest": {
        "type": "object",
        "description": "Body of a one-shot query. The caller supplies only the SQL; every safety\nbound (read-only role, statement timeout, forced `LIMIT`, row/byte caps) is\napplied server-side and is deliberately *not* expressible here — a client\ncannot raise its own limits.",
        "required": [
          "sql"
        ],
        "properties": {
          "sql": {
            "type": "string",
            "description": "The SQL to run against the datasource. Pushed down to the source database\nso `WHERE`/`LIMIT` execute there, not in memory."
          }
        }
      },
      "QueryResponse": {
        "type": "object",
        "description": "A completed query result: column schema, rows as JSON objects keyed by\ncolumn name, and execution stats. Rows are an array of objects rather than a\ncolumn-major frame because panels consume row records directly.",
        "required": [
          "columns",
          "rows",
          "stats"
        ],
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ColumnSchema"
            },
            "description": "Ordered column schema for the result set."
          },
          "rows": {
            "type": "array",
            "items": {},
            "description": "One JSON object per row, keyed by column name."
          },
          "stats": {
            "$ref": "#/components/schemas/QueryStats",
            "description": "Execution metadata, including the `truncated` cap signal."
          }
        }
      },
      "QueryStats": {
        "type": "object",
        "description": "Execution metadata returned alongside the rows. `truncated` is the signal a\ncaller needs: when `true` the result hit a server-enforced row/byte cap and\nis incomplete — the caller must narrow the query rather than assume it saw\neverything.",
        "required": [
          "row_count",
          "byte_count",
          "elapsed_ms",
          "truncated"
        ],
        "properties": {
          "byte_count": {
            "type": "integer",
            "format": "int64",
            "description": "Approximate serialized byte size of the returned rows.",
            "minimum": 0
          },
          "elapsed_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Wall-clock execution time in milliseconds.",
            "minimum": 0
          },
          "row_count": {
            "type": "integer",
            "format": "int64",
            "description": "Number of rows actually returned (after any cap).",
            "minimum": 0
          },
          "truncated": {
            "type": "boolean",
            "description": "`true` if a row/byte cap stopped the stream before it completed."
          }
        }
      },
      "RedactedConnection": {
        "type": "object",
        "description": "Connection details safe to return over the API: everything *except* the\nsecret. The password lives only as ciphertext in the store and is never\nserialized here — `GET /datasources/:id` returns this redacted view.",
        "required": [
          "host",
          "port",
          "database",
          "user",
          "has_secret"
        ],
        "properties": {
          "database": {
            "type": "string",
            "description": "Database name."
          },
          "has_secret": {
            "type": "boolean",
            "description": "Always `true` — present so the UI can show a \"secret set\" affordance\nwithout ever receiving the secret itself."
          },
          "host": {
            "type": "string",
            "description": "Database host."
          },
          "port": {
            "type": "integer",
            "format": "int32",
            "description": "Database port.",
            "minimum": 0
          },
          "user": {
            "type": "string",
            "description": "Connecting user."
          }
        }
      },
      "ResultColumnType": {
        "type": "string",
        "description": "The column's logical type, derived from the Arrow schema of the result.\nKept deliberately coarse — the frontend renders cells, it does not need the\nfull Arrow type lattice. Anything not in this set arrives as [`Self::Other`]\nwith the rows already JSON-encoded.",
        "enum": [
          "bool",
          "int",
          "float",
          "string",
          "timestamp",
          "other"
        ]
      },
      "StreamEvent": {
        "type": "object",
        "description": "One `data:` frame on a live stream. `seq` is the monotonic per-stream event\nid echoed in the SSE `id:` field so a reconnecting client can send\n`Last-Event-ID` to resume; `rows` is the batch shaped by the stream's SQL.",
        "required": [
          "seq",
          "rows"
        ],
        "properties": {
          "rows": {
            "type": "array",
            "items": {},
